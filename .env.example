# SemperVigil environment variables
# Copy to .env and adjust per host

# --- Core ---
SV_ENV=dev
SV_LOG_LEVEL=INFO
SV_LOG_TZ=America/New_York

# --- NFS layout (host paths) ---
SV_NFS_ROOT=..
SV_SITE_SRC_DIR=../site-src
SV_SITE_PUBLIC_DIR=../site-public
SV_DATA_DIR=../data
SV_LOG_DIR=../log

# --- Permissions / NFS ---
SV_UID=1000
SV_GID=1000
SV_UMASK=002

# --- Ports ---
# Public web port (nginx serving Hugo output)
SV_WEB_PORT=8080

# Admin API host port (loopback by default in compose)
SV_ADMIN_PORT=8001

# --- Admin auth (if enabled in your build) ---
# Used to protect admin endpoints (if your code enforces it)
SV_ADMIN_TOKEN=

# --- Secrets encryption (REQUIRED to store provider API keys in DB) ---
# Generate: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SEMPERVIGIL_MASTER_KEY=
SEMPERVIGIL_KEY_ID=v1

# Backward-compatible legacy env names (only needed if running older builds)
# SEMPERIVGIL_MASTER_KEY=
# SEMPERIVGIL_KEY_ID=v1

#LiteLLM key
LITELLM_MASTER_KEY=sv_local_dev_key

# --- Ingest behavior ---
SV_HTTP_TIMEOUT_SECONDS=20
SV_HTTP_USER_AGENT=SemperVigil/0.1 (+https://github.com/jasondaemon/SemperVigil)
SV_FETCH_FULL_CONTENT=1
SV_CONTENT_MIN_LEN=500
SV_STORE_ARTICLE_HTML=0
SV_INGEST_DUE_DEBOUNCE_SECONDS=60

# Default ingest cadence (minutes)
SV_INGEST_DEFAULT_INTERVAL_MINUTES=60

# Pause source after N consecutive failures
SV_SOURCE_FAILURE_THRESHOLD=5

# --- Storage ---
# Postgres URL (required).
# Example: postgresql://sempervigil:sempervigil@db:5432/sempervigil
SV_DB_URL=
SV_DB_NAME=sempervigil
SV_DB_USER=sempervigil
SV_DB_PASSWORD=sempervigil

# --- NVD (optional) ---
NVD_API_KEY=

# --- LLM (LiteLLM OpenAI-compatible) ---
SV_LLM_BASE_URL=
SV_LLM_API_KEY=
SV_LLM_MODEL=ollama/llama3
SV_LLM_TEMPERATURE=0.2
SV_LLM_MAX_TOKENS=256
SV_LLM_MAX_INFLIGHT=1
SV_LLM_MAX_TIMEOUT_RETRIES=0

# --- Event enrichment (SearXNG) ---
SV_SEARXNG_URL=http://searxng:8080
SV_SEARXNG_ENGINES=google,bing,duckduckgo
SV_SEARXNG_CATEGORIES=news
SV_SEARXNG_TIMEOUT_S=20
SV_SEARXNG_MAX_RESULTS=10
SV_ENRICH_MIN_SCORE=20
SV_ENRICH_DOMAIN_ALLOWLIST=thehackernews.com,bleepingcomputer.com,krebsonsecurity.com,securelist.com,unit42.paloaltonetworks.com
SV_ENRICH_DOMAIN_BLOCKLIST=twitter.com,facebook.com,linkedin.com
SV_ENRICH_ENABLE_LLM=0
SV_EVENT_ENRICH_AUTO_FETCH=0
SV_EVENT_ENRICH_AUTO_FETCH_MIN_SCORE=25
SV_EVENT_ENRICH_AUTO_FETCH_MAX_PER_RUN=5
SV_EVENT_ENRICH_VALIDATE_MIN_CONFIDENCE=0.70
SV_EVENT_ENRICH_VALIDATE_REQUIRE_LLM=0
SV_EVENT_ENRICH_VALIDATE_AUTO_DISCARD=1
SV_EVENT_ENRICH_VALIDATION_PROFILE_ID=

# --- Hugo ---
SV_HUGO_BASEURL=http://localhost:8080/
SV_HUGO_BASEURL=http://localhost:8080/

# Builder scheduler poll interval (seconds)
SV_BUILDER_POLL_SECONDS=60

# Publishing
SV_ENABLE_ARTICLE_MARKDOWN=0
SV_DAILY_SUMMARY_PROMPT=

# Build debouncing (seconds)
SV_BUILD_DEBOUNCE_SECONDS=60

# Maximum historical feed days repaired alongside a normal refresh (0 disables
# background catch-up). A five-second budget is checked between historical days.
# Explicit archive-rebuild jobs are not subject to this background limit.
SV_FEED_ARCHIVE_BACKGROUND_DAYS=25

# Optional local stdio investigation adapter. Not used by production workers.
# Use a dedicated restricted database role, never SV_DB_URL or an admin login.
SV_INVESTIGATION_MCP_ENABLED=0
SV_INVESTIGATION_DB_URL=
SV_INVESTIGATION_EVIDENCE_ENABLED=0
SV_INVESTIGATION_MAX_CALLS=100
SV_INVESTIGATION_SESSION_SECONDS=900

# Private extractive review queue: enable only after both admin and worker upgrade.
# No model calls by default; optional assessment requires a dedicated bounded profile.
# Never publishes. Artifacts must stay below the private log root.
SV_EVENT_REVIEW_ENABLED=0
SV_EVENT_REVIEW_MODEL_ENABLED=0
SV_EVENT_REVIEW_PROFILE_ID=
SV_EVENT_REVIEW_DIR=/log/event-reviews
# Prepared only: keep disabled until qualified export/manifest coordination is deployed.
# Requires separately provisioned credentials; never falls back to the general app role.
SV_EVENT_ACTIVATION_CHECK=0
SV_EVENT_ACTIVATION_DB_URL=
# Builder-owned Events export; requires activation check and coordinated workers.
SV_EVENT_PUBLICATION_ENABLED=0
# Human-reviewed staging pilot. Keep off until additive schemas/roles are provisioned.
# Admin role can record approvals, but cannot promote; worker role cannot approve.
SV_EVENT_HUMAN_APPROVAL_ENABLED=0
SV_EVENT_APPROVAL_DB_URL=
SV_EVENT_PROMOTION_DB_URL=
